#!/usr/bin/env bash
set -euo pipefail

commit_msg_file="${1:-}"
repo_root="$(cd "$(dirname "$0")/.." && pwd)"
normalizer="$repo_root/scripts/normalize-commit-msg.sh"

if [ -z "$commit_msg_file" ]; then
  echo "ERROR: missing commit message file argument" >&2
  exit 2
fi
if [ ! -x "$normalizer" ]; then
  echo "ERROR: normalizer script is missing or not executable: $normalizer" >&2
  exit 2
fi

exec "$normalizer" "$commit_msg_file"
