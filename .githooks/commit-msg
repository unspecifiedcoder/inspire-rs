#!/usr/bin/env bash
#
# commit-msg hook – validates Conventional Commits format.
#
# Allowed types: feat, fix, docs, chore, refactor, test, ci, style, perf, build
# Format: <type>[(<scope>)][!]: <description>
#
# Exceptions (always allowed through):
#   - Merge commits (start with "Merge ")
#   - fixup!/squash!/amend! prefixes (generated by git commit --fixup/--squash)

commit_msg_file="$1"
commit_msg=$(head -1 "$commit_msg_file")

# Allow merge commits
if echo "$commit_msg" | grep -qE '^Merge '; then
  exit 0
fi

# Allow fixup, squash, and amend prefixes
if echo "$commit_msg" | grep -qE '^(fixup|squash|amend)! '; then
  exit 0
fi

# Validate Conventional Commits format
# <type>[(<scope>)][!]: <description>
if echo "$commit_msg" | grep -qE '^(feat|fix|docs|chore|refactor|test|ci|style|perf|build)(\([a-zA-Z0-9_/ -]+\))?\!?: .+'; then
  exit 0
fi

echo >&2 "ERROR: Commit message does not follow Conventional Commits format."
echo >&2 ""
echo >&2 "  Expected: <type>[(<scope>)][!]: <description>"
echo >&2 "  Types:    feat, fix, docs, chore, refactor, test, ci, style, perf, build"
echo >&2 ""
echo >&2 "  Examples:"
echo >&2 "    feat: add new query mode"
echo >&2 "    fix(server): handle empty database"
echo >&2 "    docs: update README examples"
echo >&2 "    chore!: drop legacy API"
echo >&2 ""
echo >&2 "  Your message: $commit_msg"
exit 1
